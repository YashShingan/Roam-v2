# ==========================================
# Roam AI & Voice Assistant Environment Variables
# (All keys are optional — Roam runs 100% keyless by default!)
# ==========================================

# 1. Groq Cloud (Recommended for Agentic Voice & Planning)
# - Ultra-fast Llama 3.3 70B Versatile for multi-day itineraries & function calling
# - Whisper Large v3 for sub-second, Indian-accent and regional place name speech recognition
# - 100% Free tier available at: https://console.groq.com/keys
GROQ_API_KEY=

# 2. OpenRouter (Optional fallback)
# - Free and open-source models via OpenAI-compatible endpoints
# - Get keys at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3. Local Ollama (Optional offline LLM)
# - Run local models like llama3.2, mistral, or qwen2.5
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
